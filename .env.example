# Copy this file to .env and replace placeholders before running locally.
DB_NAME=agri_voice
DB_USERNAME=agri_voice
DB_PASSWORD=replace_with_a_local_password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/agri_voice
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
VOICE_WS_PATH=/media
VOICE_WS_MAX_TEXT_MESSAGE_SIZE=150000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_STT_ENABLED=true
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_STT_SAMPLE_RATE=16000
GEMINI_STT_MODE=VERBATIM
GEMINI_STT_LANGUAGE_CODES=
GEMINI_STT_CUSTOM_VOCABULARY=wheat,rice,paddy,maize,गेहूं,धान,चावल,मंडी,mandi,MSP,quintal,क्विंटल,किसान,FPO,फसल,भाव
GEMINI_STT_QUEUE_CAPACITY=20
GEMINI_LLM_ENABLED=true
# Optional: set GEMINI_LLM_API_KEY only when LLM and STT use different keys.
# GEMINI_LLM_API_KEY=replace_with_a_separate_gemini_api_key
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_TIMEOUT=20s
GEMINI_LLM_MAX_OUTPUT_TOKENS=96
GEMINI_LLM_MAX_INPUT_CHARACTERS=16000
GEMINI_LLM_MAX_RESPONSE_CHARACTERS=2000
GEMINI_LLM_MAX_RESPONSE_BODY_BYTES=262144
GEMINI_LLM_THINKING_LEVEL=minimal
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_MAX_CONTEXT_CHARACTERS=8000
CONVERSATION_MAX_MESSAGE_CHARACTERS=2000
CONVERSATION_DUPLICATE_WINDOW_SIZE=32
