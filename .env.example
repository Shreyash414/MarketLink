# MarketLink Environment Configuration Template
# Copy this file to .env and configure local credentials

# Government Open Data API Key (AGMARKNET Mandi Price Ingestion)
DATA_GOV_API_KEY=

# Redis Job Storage (Phase 1B)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Ollama Local LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
